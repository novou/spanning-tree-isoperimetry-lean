import SquareMaximality.Multigraph.All
import Mathlib.Combinatorics.SimpleGraph.Connectivity.Finite

set_option autoImplicit false

/-!
# Simultaneous contraction of labelled multigraph edges

The endpoints of the selected labels generate connected components in their
underlying simple graph.  Mapping every vertex to its component contracts each
such component to one vertex; loop deletion then discards exactly the labels
whose two endpoints have coalesced while retaining all parallel labels.
-/

namespace SquareMaximality.Multigraph

namespace LabeledMultigraph

variable {V E Q : Type*} (G : LabeledMultigraph V E)

/-- Map the endpoints of every edge along a vertex map. -/
def mapVertices (q : V → Q) : LabeledMultigraph Q E where
  ends e := Sym2.map q (G.ends e)

@[simp] theorem mapVertices_ends (q : V → Q) (e : E) :
    (G.mapVertices q).ends e = Sym2.map q (G.ends e) :=
  rfl

@[simp] theorem mapVertices_isLink (q : V → Q) (e : E) (u v : V)
    (h : G.IsLink e u v) :
    (G.mapVertices q).IsLink e (q u) (q v) := by
  change Sym2.map q (G.ends e) = s(q u, q v)
  rw [h]
  exact Sym2.map_mk q u v

/-- Component map generated by a selected label set. -/
def contractionMap (F : Finset E) :
    V → (G.simpleGraphOn (F : Set E)).ConnectedComponent :=
  (G.simpleGraphOn (F : Set E)).connectedComponentMk

/-- Quotient the vertices by the connected components generated by `F`.
Loops are still present at this intermediate stage. -/
def contractWithLoops (F : Finset E) :
    LabeledMultigraph (G.simpleGraphOn (F : Set E)).ConnectedComponent E :=
  G.mapVertices (G.contractionMap F)

/-- Simultaneously contract `F`, discard the resulting loops, and retain all
remaining labels (including parallel ones). -/
def contract (F : Finset E) :
    LabeledMultigraph (G.simpleGraphOn (F : Set E)).ConnectedComponent
      (G.contractWithLoops F).NonLoopEdge :=
  (G.contractWithLoops F).deleteLoops

@[simp] theorem contractWithLoops_ends (F : Finset E) (e : E) :
    (G.contractWithLoops F).ends e = Sym2.map (G.contractionMap F) (G.ends e) :=
  rfl

/-- Every selected nonloop label becomes a loop after its component is
contracted. -/
theorem contractWithLoops_isLoop_of_mem
    {F : Finset E} {e : E} (heF : e ∈ F) (he : ¬G.IsLoop e) :
    (G.contractWithLoops F).IsLoop e := by
  obtain ⟨u, v, huv⟩ : ∃ u v, G.IsLink e u v := by
    induction hends : G.ends e using Sym2.inductionOn with
    | _ u v => exact ⟨u, v, hends⟩
  have huvne : u ≠ v := by
    intro huvEq
    subst v
    apply he
    exact (G.isLoop_iff_exists_isLoopAt e).mpr ⟨u, huv⟩
  have hadj : (G.simpleGraphOn (F : Set E)).Adj u v :=
    ⟨huvne, e, by simpa, huv⟩
  have hcomponent : G.contractionMap F u = G.contractionMap F v :=
    by
      unfold contractionMap
      exact SimpleGraph.ConnectedComponent.sound hadj.reachable
  change (Sym2.map (G.contractionMap F) (G.ends e)).IsDiag
  rw [huv, Sym2.map_mk, hcomponent]
  exact Sym2.diag_isDiag _

/-- A surviving contraction edge is an original label not collapsed to a
loop. -/
@[simp] theorem contract_edge_coe_not_loop (F : Finset E)
    (e : (G.contractWithLoops F).NonLoopEdge) :
    ¬(G.contractWithLoops F).IsLoop e.1 :=
  e.2

end LabeledMultigraph

end SquareMaximality.Multigraph
