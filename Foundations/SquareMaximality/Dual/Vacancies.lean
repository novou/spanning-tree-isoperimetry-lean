module

public import SquareMaximality.Dual.Rectangle
public import SquareMaximality.Boundary.King

@[expose] public section

set_option autoImplicit false

/-!
# Dual edge sets generated by vacant primal vertices

This is the finite edge-labelled version of `E_X^⋆` and `H_X` from
`general.tex`, lines 602--612.  A label is selected exactly when its primal
edge has an endpoint in `X`; `dualEdgeGraph` retains those labels while its
underlying simple graph automatically suppresses isolated vertices when one
passes to nontrivial connected components.
-/

namespace SquareMaximality

namespace Dual

open Multigraph

/-- Forget the finite-bound proofs on a primal rectangle vertex. -/
def finPoint {r s : ℕ} (p : Fin r × Fin s) : Boundary.LatticePoint :=
  (p.1.1, p.2.1)

theorem finPoint_injective {r s : ℕ} :
    Function.Injective (finPoint (r := r) (s := s)) := by
  intro p q h
  apply Prod.ext <;> apply Fin.ext
  · exact congrArg (fun z => z.1) h
  · exact congrArg (fun z => z.2) h

/-- A labelled rectangular edge is incident with a displayed primal vertex. -/
def PrimalIncident {r s : ℕ} (p : Fin r × Fin s) : RectangleEdge r s → Prop
  | .horizontal e => p = horizontalPrimalLeft e ∨ p = horizontalPrimalRight e
  | .vertical e => p = verticalPrimalBottom e ∨ p = verticalPrimalTop e

theorem primalIncident_iff_isLink
    {r s : ℕ} {p : Fin r × Fin s} {e : RectangleEdge r s} :
    PrimalIncident p e ↔ ∃ q, (rectanglePrimal r s).IsLink e p q := by
  cases e with
  | horizontal e =>
      simp only [PrimalIncident, LabeledMultigraph.IsLink, rectanglePrimal]
      constructor
      · intro hp
        rcases hp with rfl | rfl
        · exact ⟨horizontalPrimalRight e, rfl⟩
        · exact ⟨horizontalPrimalLeft e, Sym2.eq_swap⟩
      · rintro ⟨q, hq⟩
        rcases Sym2.eq_iff.mp hq with hq | hq
        · exact Or.inl hq.1.symm
        · exact Or.inr hq.2.symm
  | vertical e =>
      simp only [PrimalIncident, LabeledMultigraph.IsLink, rectanglePrimal]
      constructor
      · intro hp
        rcases hp with rfl | rfl
        · exact ⟨verticalPrimalTop e, rfl⟩
        · exact ⟨verticalPrimalBottom e, Sym2.eq_swap⟩
      · rintro ⟨q, hq⟩
        rcases Sym2.eq_iff.mp hq with hq | hq
        · exact Or.inl hq.1.symm
        · exact Or.inr hq.2.symm

/-- Nearest-neighbour primal adjacency is a king move after forgetting bounds. -/
theorem kingAdjacent_of_rectanglePrimal_adj
    {r s : ℕ} {p q : Fin r × Fin s}
    (hpq : (rectanglePrimal r s).toSimpleGraph.Adj p q) :
    Boundary.KingAdjacent (finPoint p) (finPoint q) := by
  have hpqne : p ≠ q := hpq.ne
  rw [rectanglePrimal_toSimpleGraph] at hpq
  rcases hpq with hpq | hpq
  · rcases hpq with ⟨hx, hy⟩
    rw [SimpleGraph.pathGraph_adj] at hx
    simp only [Boundary.KingAdjacent, finPoint]
    constructor
    · exact finPoint_injective.ne hpqne
    · constructor
      · rcases hx with hx | hx <;> simp [Nat.dist] <;> omega
      · simp [hy, Nat.dist]
  · rcases hpq with ⟨hy, hx⟩
    rw [SimpleGraph.pathGraph_adj] at hy
    simp only [Boundary.KingAdjacent, finPoint]
    constructor
    · exact finPoint_injective.ne hpqne
    · constructor
      · simp [hx, Nat.dist]
      · rcases hy with hy | hy <;> simp [Nat.dist] <;> omega

/-- Two vertices incident with one rectangular edge are equal or adjacent. -/
theorem eq_or_rectanglePrimal_adj_of_incident
    {r s : ℕ} {p q : Fin r × Fin s} {e : RectangleEdge r s}
    (hp : PrimalIncident p e) (hq : PrimalIncident q e) :
    p = q ∨ (rectanglePrimal r s).toSimpleGraph.Adj p q := by
  by_cases hpq : p = q
  · exact Or.inl hpq
  · right
    refine ⟨hpq, e, ?_⟩
    cases e with
    | horizontal e =>
        rcases hp with rfl | rfl <;> rcases hq with rfl | rfl
        · exact (hpq rfl).elim
        · rfl
        · exact Sym2.eq_swap
        · exact (hpq rfl).elim
    | vertical e =>
        rcases hp with rfl | rfl <;> rcases hq with rfl | rfl
        · exact (hpq rfl).elim
        · rfl
        · exact Sym2.eq_swap
        · exact (hpq rfl).elim
/-- The dual labels of all primal edges incident with at least one vertex in
`X`. -/
noncomputable def vacancyDualEdges {r s : ℕ}
    (X : Finset (Fin r × Fin s)) : Finset (RectangleEdge r s) := by
  classical
  exact Finset.univ.filter fun e => ∃ p ∈ X, PrimalIncident p e

@[simp] theorem mem_vacancyDualEdges
    {r s : ℕ} {X : Finset (Fin r × Fin s)} {e : RectangleEdge r s} :
    e ∈ vacancyDualEdges X ↔ ∃ p ∈ X, PrimalIncident p e := by
  classical
  simp [vacancyDualEdges]

@[simp] theorem vacancyDualEdges_empty (r s : ℕ) :
    vacancyDualEdges (r := r) (s := s) ∅ = ∅ := by
  classical
  ext e
  simp

theorem vacancyDualEdges_mono
    {r s : ℕ} {X Y : Finset (Fin r × Fin s)} (hXY : X ⊆ Y) :
    vacancyDualEdges X ⊆ vacancyDualEdges Y := by
  intro e he
  rcases mem_vacancyDualEdges.mp he with ⟨p, hpX, hpe⟩
  exact mem_vacancyDualEdges.mpr ⟨p, hXY hpX, hpe⟩

theorem vacancyDualEdges_union
    {r s : ℕ} (X Y : Finset (Fin r × Fin s)) :
    vacancyDualEdges (X ∪ Y) = vacancyDualEdges X ∪ vacancyDualEdges Y := by
  classical
  ext e
  simp only [mem_vacancyDualEdges, Finset.mem_union]
  constructor
  · rintro ⟨p, hpX | hpY, hpe⟩
    · exact Or.inl ⟨p, hpX, hpe⟩
    · exact Or.inr ⟨p, hpY, hpe⟩
  · rintro (⟨p, hpX, hpe⟩ | ⟨p, hpY, hpe⟩)
    · exact ⟨p, Or.inl hpX, hpe⟩
    · exact ⟨p, Or.inr hpY, hpe⟩

/-- King-separated primal sets generate disjoint dual label sets.  This is the
edge-disjointness fact used for distinct vacancy components. -/
theorem disjoint_vacancyDualEdges_of_kingSeparated
    {r s : ℕ} {X Y : Finset (Fin r × Fin s)}
    (hsep : ∀ p ∈ X, ∀ q ∈ Y,
      p ≠ q ∧ ¬Boundary.KingAdjacent (finPoint p) (finPoint q)) :
    Disjoint (vacancyDualEdges X) (vacancyDualEdges Y) := by
  rw [Finset.disjoint_left]
  intro e heX heY
  rcases mem_vacancyDualEdges.mp heX with ⟨p, hpX, hpe⟩
  rcases mem_vacancyDualEdges.mp heY with ⟨q, hqY, hqe⟩
  have hseparate := hsep p hpX q hqY
  rcases eq_or_rectanglePrimal_adj_of_incident hpe hqe with hpq | hpq
  · exact hseparate.1 hpq
  · exact hseparate.2 (kingAdjacent_of_rectanglePrimal_adj hpq)

/-- The simple dual subgraph supported by `E_X^⋆`.  Parallel edge labels are
still available in `vacancyDualEdges`; this graph is used only for components
and connectivity. -/
def dualEdgeGraph {r s : ℕ} (X : Finset (Fin r × Fin s)) :
    SimpleGraph (RectangleDualVertex r s) :=
  (rectangleDual r s).simpleGraphOn (vacancyDualEdges X : Set (RectangleEdge r s))

@[simp] theorem dualEdgeGraph_adj_iff
    {r s : ℕ} {X : Finset (Fin r × Fin s)}
    (u v : RectangleDualVertex r s) :
    (dualEdgeGraph X).Adj u v ↔
      u ≠ v ∧ ∃ e ∈ vacancyDualEdges X, (rectangleDual r s).IsLink e u v :=
  Iff.rfl

/-- `H_X` with isolated dual vertices suppressed. -/
def dualEdgeCore {r s : ℕ} (X : Finset (Fin r × Fin s)) :
    SimpleGraph {v // v ∈ (dualEdgeGraph X).support} :=
  (dualEdgeGraph X).induce (dualEdgeGraph X).support

end Dual

end SquareMaximality
